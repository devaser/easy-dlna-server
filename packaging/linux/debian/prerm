#!/bin/sh
# Easy DLNA Server - runs before the files are removed or replaced.
set -e

UNIT=/etc/systemd/system/easydlna.service
AWAKE_SERVICE=/etc/systemd/system/easydlna-awake.service
AWAKE_PATH=/etc/systemd/system/easydlna-awake.path
SYSTEMD=0

if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    SYSTEMD=1
fi

case "$1" in
    upgrade)
        # Stop the system service while the files change; postinst starts it.
        if [ "$SYSTEMD" = 1 ] && systemctl is-active --quiet easydlna.service; then
            touch /run/easydlna.restart
            systemctl stop easydlna.service || true
        fi
        ;;
    remove|deconfigure)
        if [ "$SYSTEMD" = 1 ] && [ -f "$UNIT" ]; then
            systemctl stop easydlna.service || true
            systemctl disable easydlna.service || true
        fi
        if [ "$SYSTEMD" = 1 ] && [ -f "$AWAKE_PATH" ]; then
            systemctl disable --now easydlna-awake.path || true
            systemctl stop easydlna-awake.service || true
        fi
        rm -f "$UNIT" "$AWAKE_SERVICE" "$AWAKE_PATH"
        if [ "$SYSTEMD" = 1 ]; then
            systemctl daemon-reload || true
        fi
        echo "If you installed a user service, remove it with: easydlna uninstall-service --user"
        ;;
esac

exit 0
