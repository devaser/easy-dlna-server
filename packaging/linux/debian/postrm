#!/bin/sh
# Easy DLNA Server - runs after the files are removed.
set -e

if [ "$1" = "purge" ]; then
    # Purge removes the data of the system service and its user.
    rm -rf /var/lib/easydlna
    if getent passwd easydlna >/dev/null 2>&1; then
        userdel easydlna >/dev/null 2>&1 || true
    fi
    echo "Easy DLNA Server was purged. Any ufw rules were left untouched."
fi

exit 0
