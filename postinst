#!/bin/sh
# Easy DLNA Server - runs after the files are installed.
set -e

if [ "$1" = "configure" ]; then

    # An upgrade stopped the system service in prerm: start it again.
    if [ -f /run/easydlna.restart ]; then
        rm -f /run/easydlna.restart
        systemctl start easydlna.service || true
    fi

    echo
    echo "Easy DLNA Server is installed."
    echo "Next step: run 'easydlna setup' to install it as a user or system service."
    echo
fi

exit 0
